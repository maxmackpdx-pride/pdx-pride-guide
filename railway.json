{
  "$schema": "https://schema.railway.app/railway-schema-v2.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --include=dev && npm run build"
  },
  "deploy": {
    "startCommand": "sh -c 'echo STAGING_BOOT cwd=$(pwd); ls -la dist || echo NO_DIST; exec npm start'",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
