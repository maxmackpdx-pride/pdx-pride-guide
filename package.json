{
  "name": "rest-express",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "node script/prepare-local-db.mjs && DATABASE_PATH=.local/data.db NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "predeploy": "bash script/predeploy-check.sh",
    "verify:deploy": "node script/verify-deploy-bundle.mjs",
    "test:community": "node --import tsx --test server/communityPrivacy.test.ts server/communityOutzPermissions.test.ts server/communityChat.test.ts",
    "test:platform": "node --import tsx --test server/platformV1.test.ts server/platformV1Privacy.test.ts server/push/intent.test.ts",
    "ship": "npm run predeploy && npm run build && npm run verify:deploy",
    "start": "NODE_ENV=production node dist/index.cjs",
    "preview:local": "npm run build && node script/prepare-local-db.mjs && DATABASE_PATH=.local/data.db SESSION_SECRET=dev LOCAL_PREVIEW=1 NODE_ENV=production PORT=5050 node dist/index.cjs",
    "check": "tsc",
    "typecheck": "tsc --noEmit",
    "test:mapz": "node --import tsx --test script/map-release.test.mjs script/home-flight-shared-scene.test.mjs script/mapz-outzide-tokens.test.mjs script/map-startup-delivery.test.ts client/src/lib/mapRouteRetention.test.ts client/src/lib/oneShotMapLocation.test.ts server/mapSocialContent.test.ts server/mapSocialRoutes.test.ts",
    "cards:gate:start": "node script/card-design-gates.mjs start",
    "cards:gate:api": "node script/card-design-gates.mjs api",
    "cards:gate:glass": "node script/card-design-gates.mjs glass",
    "cards:gate:copy": "node script/card-design-gates.mjs copy",
    "audit:glass-rebind": "node script/audit-glass-rebind.mjs",
    "preview:ds": "NODE_ENV=development tsx server/index.ts",
    "design:proposal": "tsx script/prepare-design-component-proposal.ts",
    "design:publication": "tsx script/design-product-publication.ts",
    "design:railway-gate": "tsx script/verify-railway-design-build.ts",
    "db:push": "node script/prepare-local-db.mjs && DATABASE_PATH=.local/data.db drizzle-kit push",
    "git:worktree-prune": "bash script/prune-stale-worktrees.sh",
    "git:closeout": "bash script/check-git-closeout.sh",
    "build:profile-objects": "node --import tsx script/build-profile-objects.mjs"
  },
