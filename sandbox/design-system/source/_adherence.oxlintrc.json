{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/data-display/**",
              "components/forms/**",
              "components/layout/**",
              "components/map/**",
              "ui_kits/pride-guide/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow Condensed|Inter))/i]",
        "message": "Font not provided by the design system. Available: Barlow Condensed, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|ring|status|statusColor|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, ring, status, statusColor."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='ring'] > Literal[value!=/^(?:rainbow|neutral|MON|TUE|WED|THU|FRI|SAT|SUN)$/]",
        "message": "<Avatar> ring must be one of 'rainbow' | 'neutral' | 'MON' | 'TUE' | 'WED' | 'THU' | 'FRI' | 'SAT' | 'SUN'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|variant|size|glow|dot|admission|day|category|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, color, variant, size, glow, dot, admission, day, category."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|paper)$/]",
        "message": "<Badge> variant must be one of 'solid' | 'outline' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='admission'] > Literal[value!=/^(?:FREE|TICKETED|SUGGESTED_DONATION)$/]",
        "message": "<Badge> admission must be one of 'FREE' | 'TICKETED' | 'SUGGESTED_DONATION'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='day'] > Literal[value!=/^(?:THU|FRI|SAT|SUN)$/]",
        "message": "<Badge> day must be one of 'THU' | 'FRI' | 'SAT' | 'SUN'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:bars|food|cafes|venues|services|shops|hotels)$/]",
        "message": "<Badge> category must be one of 'bars' | 'food' | 'cafes' | 'venues' | 'services' | 'shops' | 'hotels'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|accent|size|block|live|arrow|leadingIcon|trailingIcon|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, accent, size, block, live, arrow, leadingIcon, trailingIcon, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neon|solid|gradient|pill|ghost)$/]",
        "message": "<Button> variant must be one of 'neon' | 'solid' | 'gradient' | 'pill' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:target|size|accent|doneLabel|key|ref|className|style|children)$/]",
        "message": "<Countdown> doesn't accept that prop. Declared props: target, size, accent, doneLabel."
      },
