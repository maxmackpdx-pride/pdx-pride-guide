    "workflow": ".github/workflows/github-pages.yml",
    "statusPage": "https://github.com/maxmackpdx-pride/pdx-pride-guide/actions/workflows/github-pages.yml"
   }
  },
  "railway": {
   "project": "zaylist",
   "service": "pdx-pride-guide",
