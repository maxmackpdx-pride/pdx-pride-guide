    "START_HERE.md",
    "manifest.json",
    "current-context.json",
    "conflicts.json"
   ],
   "appendEventTypes": [
    "direction_added",
    "direction_corrected",
    "decision_changed",
    "evidence_changed",
    "campaign_created",
    "audit_completed",
    "conflict_opened",
    "conflict_resolved",
    "blocker_changed",
    "handoff_changed"
   ]
  }
